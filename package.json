  "type": "module",
  "description": "Solum-care - gestión y seguimiento de curación de tatuajes",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && node scripts/check-imports.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
